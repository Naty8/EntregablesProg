// 7 (validación esquema)
db.createCollection("empleados", {
  validator: {
    $jsonSchema: {
      bsonType: "object",
      required: ["edad"],
      properties: {
        edad: {
          bsonType: "int",
          minimum: 19,
          description: "Edad debe ser mayor a 18"
        }
      }
    }
  }
});

// 8
db.clientes.updateMany({}, { $set: { activo: true } });

