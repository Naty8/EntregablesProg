-- 6
SELECT COUNT(*) FROM empleados;

-- 7
SELECT * FROM empleados WHERE nombre LIKE 'A%';

-- 8
CREATE TABLE departamentos (
  id INT PRIMARY KEY,
  nombre VARCHAR(100),
  ubicacion VARCHAR(100)
);

-- 9
ALTER TABLE empleados ADD id_departamento INT;
ALTER TABLE empleados 
ADD CONSTRAINT fk_departamento FOREIGN KEY (id_departamento) REFERENCES departamentos(id);

-- 10
SELECT id_departamento, AVG(salario) AS promedio_salario
FROM empleados
GROUP BY id_departamento;

-- 11
SELECT * FROM empleados WHERE edad BETWEEN 25 AND 40;

-- 12
SELECT * FROM empleados ORDER BY salario DESC LIMIT 3;
